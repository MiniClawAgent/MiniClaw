<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- HomeKit：apple-homekit 工具读写配件与场景所必需。
	     需在 Apple 开发者后台为 App ID 勾选 HomeKit capability 并重生成 profile 后才能真机签名通过。 -->
	<key>com.apple.developer.homekit</key>
	<true/>
	<!-- App Group：系统分享收件箱（ShareExtension 落内容 → 主 App 消费）。
	     需在 Apple 开发者后台创建同名 App Group，并为 App ID
	     com.neartop.miniclaw.app 与 com.neartop.miniclaw.app.shareext
	     双双勾选 App Groups capability（两个 App ID 都要勾，只勾一个会导致
	     扩展侧 containerURL 返回 nil、分享内容丢失）。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.neartop.miniclaw.app</string>
	</array>
</dict>
</plist>
