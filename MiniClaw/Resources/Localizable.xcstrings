    "a_context_limit_of_0_means_using_the_model_s_native_window_size" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A context limit of 0 means using the model's native window size."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキスト上限を 0 にすると、モデルのネイティブなウィンドウサイズを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트 한도 0은 모델의 기본 창 크기를 사용함을 의미합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文上限 0 表示使用模型原生窗口大小。"
          }
        }
      }
    },
    "a_model_group_is_saved_immediately_even_if_no_models_are_linked_yet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A model group is saved immediately even if no models are linked yet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルグループはモデルが関連付けられていなくてもすぐに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 그룹은 모델이 연결되지 않았더라도 즉시 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型组即使尚未关联模型也会立即保存。"
          }
        }
      }
