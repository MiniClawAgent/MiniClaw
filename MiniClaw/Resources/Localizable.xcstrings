          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要加载的技能名（与 system 中「已启用技能」列出的 name 完全一致，例如 git-workflow）"
          }
        }
      }
    },
    "param_speech_duration" : {
      "extractionState" : "manual",
      "localizations" : {
