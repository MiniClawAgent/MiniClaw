    "health_param_action" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Action: summary (today/7-day overview), query (raw samples), write (add one sample), delete (remove samples this app wrote), types (list supported metrics), workouts (list workouts), characteristic (biological sex / blood type / birth year)., range_report (multi-metric daily report: metrics array + any range in one call — always use this for multi-day analysis)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作種別：summary（今日と直近7日の概要）、query（生サンプルの照会）、write（サンプルを1件書き込み）、delete（このアプリが書き込んだサンプルを削除）、types（対応指標の一覧）、workouts（ワークアウト一覧）、characteristic（生物学的性別／血液型／生年）。, range_report（複数指標の日別レポート：metrics 配列＋任意の期間を1回で取得。複数日の分析には必須）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 유형: summary(오늘/최근 7일 요약), query(원본 샘플 조회), write(샘플 1건 기록), delete(이 앱이 기록한 샘플 삭제), types(지원 지표 목록), workouts(운동 기록 목록), characteristic(생물학적 성별/혈액형/출생 연도)., range_report(다중 지표 일별 보고서: metrics 배열 + 임의 기간을 한 번에 조회. 여러 날 분석에 필수)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作类型：summary（今日与近 7 天概览）、query（查询原始样本）、write（写入一条样本）、delete（删除本 App 写入的样本）、types（列出支持的指标）、workouts（列出运动记录）、characteristic（生理性别/血型/出生年份）。、range_report（多指标逐日报表：metrics 数组 + 任意区间，一次取回，分析多天数据必须用它）"
          }
        }
      }
    },
    "health_param_aggregate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
