    "lists_each_session_s_on_device_file_usage_workspace_attachments_browser_offloads_excluding_the_chat_history_itself_sorted_by_size_largest_first" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists each session's on-device file usage (workspace/attachments/browser/offloads), excluding the chat history itself. Sorted by size, largest first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各セッションのデバイス上のファイル使用量（ワークスペース/添付/ブラウザ/オフロード）を一覧表示します。チャット履歴自体は含みません。サイズの大きい順に並べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 세션의 기기 파일 사용량(작업 공간/첨부/브라우저/오프로드)을 나열합니다. 채팅 기록 자체는 제외합니다. 사용량 큰 순으로 정리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出每个会话在设备上的文件占用（工作区/附件/浏览器/转存），不含聊天记录本身。按占用从大到小排序。"
          }
        }
      }
    },
    "lists_the_permissions_this_app_may_request_and_their_current_authorization_status" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists the permissions this app may request and their current authorization status."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリが要求する可能性のある権限と現在の認可状態を一覧表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱이 요청할 수 있는 권한과 현재 승인 상태를 나열합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出本应用可能申请的权限及其当前授权状态。"
          }
        }
      }
    },
    "lists_the_permissions_this_app_may_request_and_their_current_authorization_status_tap_an_unauthorized_item_to_request_it_in_app_or_jump_to_system_settings_to_enable_it" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists the permissions this app may request and their current authorization status. Tap an unauthorized item to request it in-app, or jump to system settings to enable it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリが要求する可能性のある権限と現在の許可状態を一覧表示します。未許可の項目をタップするとアプリ内で要求するか、システム設定へ移動して有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱이 요청할 수 있는 권한과 현재 승인 상태를 나열합니다. 승인되지 않은 항목을 탭하면 앱 내에서 요청하거나 시스템 설정으로 이동해 켤 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出本应用可能申请的权限及其当前授权状态。点击未授权项可在 App 内申请，或跳转系统设置开启。"
          }
        }
      }
    },
