    "close_subagent_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close an existing subagent that is no longer needed (e.g. a research task that is fully complete). Closing removes its conversation and avatar, frees context, and it cannot be reused (dispatch a new one if needed again)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後不要になる既存サブエージェント（例：調査タスクが完全に完了したもの）を閉じます。閉じると会話と上部のアバターが削除され、コンテキストが解放され、再利用できません（必要になったら新規に dispatch してください）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 필요 없는 기존 서브에이전트(예: 조사 작업이 완전히 끝난 경우)를 닫습니다. 닫으면 대화와 상단 아바타가 함께 제거되고 컨텍스트가 해제되며 재사용할 수 없습니다(필요하면 새로 dispatch)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭一个已存在但后续不再需要的子代理（如某调研任务已彻底完成）。关闭后其会话与上方头像一并移除、上下文释放，不可再复用（如再需要，重新派发新建即可）。"
          }
        }
      }
    },
    "code_files" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
