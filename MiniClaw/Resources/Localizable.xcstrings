    "background_theme_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the home, chat and settings backgrounds; dark mode automatically dims the image for readability. Deleting the theme plugin reverts to the system default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択するとホーム・チャット・設定の背景に適用されます。ダークモードでは自動的に暗くして可読性を確保します。テーマプラグインを削除するとシステムデフォルトに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하면 홈, 채팅, 설정 배경에 적용됩니다. 다크 모드에서는 가독성을 위해 이미지가 자동으로 어두워집니다. 테마 플러그인을 삭제하면 시스템 기본값으로 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选用后应用于首页、会话页与设置页背景；暗色模式自动加深以保证可读性。删除主题插件即回退系统默认。"
