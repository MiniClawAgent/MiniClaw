    "core_unreadable_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot read this file as text (extension: '%@'). read_document currently supports plain text/code/Markdown/JSON/CSV/XML/HTML and PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはテキストとして読めません（拡張子：'%@'）。read_document は現在プレーンテキスト/コード/Markdown/JSON/CSV/XML/HTML と PDF に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 텍스트로 읽을 수 없습니다(확장자: '%@'). read_document는 현재 일반 텍스트/코드/Markdown/JSON/CSV/XML/HTML과 PDF를 지원합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法以文本方式读取该文件（扩展名：'%@'）。read_document 当前支持纯文本/代码/Markdown/JSON/CSV/XML/HTML 与 PDF。"
          }
        }
      }
    },
    "core_unsupported_office" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot extract text from %@ yet (Office documents are compressed binaries and there is no on-device unzip library). Export the file to PDF or TXT and re-send it, then read it with read_document."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ %@ からテキストを抽出できません（Office 文書は圧縮バイナリで、端末内に解凍ライブラリがありません）。ファイルを PDF か TXT にエクスポートして再送し、read_document でお読みください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 %@에서 텍스트를 추출할 수 없습니다(Office 문서는 압축 바이너리이며 기기에 압축 해제 라이브러리가 없음). 파일을 PDF나 TXT로 내보내 다시 보낸 후 read_document로 읽으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不支持直接抽取 %@ 的文本内容（Office 文档为压缩二进制，端侧无内置解压库）。请先将文件导出为 PDF 或 TXT 后重新发送，再用 read_document 读取。"
          }
        }
      }
    },
