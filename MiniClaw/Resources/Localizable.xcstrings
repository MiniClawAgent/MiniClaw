      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live model list unavailable (HTTP %1$@); loaded %2$@ models from the built-in model catalog. For other model IDs, use “Add Custom Model” below."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムのモデル一覧は利用できません（HTTP %1$@）。内蔵のモデルカタログから %2$@ 件のモデルを読み込みました。その他のモデル ID が必要な場合は、下部の「カスタムモデルの追加」から手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
