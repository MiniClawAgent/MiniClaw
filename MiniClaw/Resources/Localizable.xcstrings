    "fs_mount_read_only" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount \"%@\" is currently read-only; the Agent cannot write to it. To enable writing, turn on \"Allow write\" for this folder in Settings → Mounts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウント「%@」は現在読み取り専用で、エージェントは書き込めません。書き込むには「設定 → マウント」でこのフォルダの「書き込み許可」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마운트 '%@'는 현재 읽기 전용이며 에이전트가 쓸 수 없습니다. 쓰려면 '설정 → 마운트'에서 이 폴더의 '쓰기 허용'을 켜세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂载「%@」当前为只读，Agent 不能写入。如需写入请在「设置 → 挂载」中开启该文件夹的「允许写入」开关。"
          }
        }
      }
    },
    "fs_offload_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output too long (%1$lld bytes); auto-offloaded to offloads/.\nFull path for file_read: `/var/MiniClaw/offloads/%2$@` (do NOT add a sessions/<uuid> segment).\nYou can also open it via the Markdown link miniclaw://offloads/%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出力が長すぎます（%1$lld バイト）。offloads/ に自動退避しました。\nfile_read で読む際のフルパス：`/var/MiniClaw/offloads/%2$@`（sessions/<uuid> セグメントは付けないでください）。\nMarkdown リンク miniclaw://offloads/%2$@ からも開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출력이 너무 깁니다(%1$lld 바이트). offloads/로 자동 이관했습니다.\nfile_read로 읽을 전체 경로: `/var/MiniClaw/offloads/%2$@` (sessions/<uuid> 세그먼트를 붙이지 마세요).\nMarkdown 링크 miniclaw://offloads/%2$@ 로도 열 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输出过长（%1$lld 字节），已自动转存至 offloads/。\n用 file_read 读取的完整路径是 `/var/MiniClaw/offloads/%2$@`（不要带 sessions/<uuid> 段）。\n也可通过 Markdown 链接打开 miniclaw://offloads/%2$@。"
          }
        }
      }
    },
