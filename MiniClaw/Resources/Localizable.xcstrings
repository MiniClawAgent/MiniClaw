    "skill_load_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load the full SKILL.md body of an enabled skill on demand. The system prompt lists the name and description of every enabled skill for your judgment; when a skill is relevant to the current task and you need to follow its instructions, call this tool to load its body. After loading, strictly follow the skill's workflow and output format in subsequent messages. name must be one of the skill names listed under \"Enabled Skills\" in the system prompt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按需加载某个已启用技能的完整 SKILL.md 正文。system 提示已列出全部启用技能的 name 与 description 供你判断；当某条技能与当前任务相关、你需要遵循其指令时，调用本工具加载其正文。加载后请在后续对话中严格遵循该技能的工作流与输出格式。name 必须是 system 中「已启用技能」列出的技能名之一。"
          }
        }
      }
    },
