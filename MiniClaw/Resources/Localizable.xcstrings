    "apple_vision_coords_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordinates are image pixels (top-left origin). If the screenshot is a cropped/scaled view of the target screen, map back to target screen coordinates using the crop offset and scale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座標は画像ピクセル（左上原点）。スクリーンショットが対象画面の切り出し/拡縮の場合、オフセットと倍率で画面座標に変換してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌표는 이미지 픽셀(좌상단 원점)입니다. 스크린샷이 대상 화면의 잘린/확대 버전이면 오프셋과 배율로 화면 좌표로 변환하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐标为图像像素（左上原点）。若截图是目标屏幕的裁剪/缩放版，请按裁剪偏移与缩放比例换算回目标屏幕坐标。"
          }
        }
      }
    },
    "apple_vision_param_mode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysis mode: analyze (classification + OCR text + faces, default); text_coords (per-text pixel coordinates, for GUI automation click targeting)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解析モード：analyze（分類+OCR テキスト+顔、既定）；text_coords（テキストごとのピクセル座標、GUI 自動化のクリック位置特定用）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분석 모드: analyze(분류+OCR 텍스트+얼굴, 기본값); text_coords(텍스트별 픽셀 좌표, GUI 자동화 클릭 위치 확인용)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析模式：analyze（分类+OCR 文本+人脸，默认）；text_coords（逐文字像素坐标，GUI 自动化点击定位用）"
          }
        }
      }
    },
    "apple_vision_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Vision on-device analysis. mode=analyze: scene classification + OCR text + faces (no coordinates, good for a rough idea of the image); mode=text_coords: per-text pixel coordinates (\"text @ (x,y)\", top-left origin) — for GUI automation click targeting. Division of labor: to judge UI state or describe the scene use apple-image (view directly); use this tool when you need text content with precise coordinates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Vision のオンデバイス解析。mode=analyze：シーン分類 + OCR テキスト + 顔（座標なし、画像の概要把握向け）；mode=text_coords：テキストごとにピクセル座標を返す（\"文字 @ (x,y)\"、左上原点）——GUI 自動化のクリック位置特定用。使い分け：画面状態の判断・描写は apple-image で直接画像を見て、テキスト内容と正確な座標が必要なときに本ツールを使用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Vision 온디바이스 분석. mode=analyze: 장면 분류 + OCR 텍스트 + 얼굴(좌표 없음, 이미지 개요 파악용); mode=text_coords: 텍스트별 픽셀 좌표 반환(\"텍스트 @ (x,y)\", 좌상단 원점) — GUI 자동화 클릭 위치 확인용. 역할 구분: 화면 상태 판단·장면 묘사는 apple-image로 직접 보고, 텍스트 내용과 정확한 좌표가 필요할 때 이 도구를 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Vision 本地分析图片。mode=analyze：场景分类 + OCR 文本 + 人脸（无坐标，适合了解图片大致内容）；mode=text_coords：逐文字返回像素坐标（\"文字 @ (x,y)\"，图像左上原点）——GUI 自动化点击定位用。分工建议：判断界面状态/描述画面直接用 apple-image 看图；需要文字内容与精确坐标时用本工具。"
          }
        }
      }
    },
