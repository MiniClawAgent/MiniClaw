          }
        }
      }
    },
    "this_will_delete_all_session_isolated_files_and_local_working_data_workspace_attachments_browser_dumps_logs_this_action_cannot_be_undone_settings_models_and_skills_are_unaffected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete all session isolated files and local working data (workspace/attachments/browser/dumps/logs). This action cannot be undone. Settings, models, and skills are unaffected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのセッション分離ファイルとローカルの作業データ（ワークスペース／添付ファイル／ブラウザ／ダンプ／ログ）を削除します。この操作は取り消せません。設定・モデル・スキルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 세션 격리 파일과 로컬 작업 데이터(작업 공간/첨부 파일/브라우저/덤프/로그)를 삭제합니다. 이 작업은 취소할 수 없습니다. 설정, 모델, 스킬에는 영향이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除全部会话隔离文件与本地工作数据（工作区/附件/浏览器/转存/日志），此操作不可撤销。设置、模型与技能不受影响。"
          }
        }
      }
    },
