    "web_search_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search the web and get ranked results (title, URL, snippet, summary, optional page content). Use it for recent information and fact-checking. Powered by DeepSeek Search."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブを検索し、順位付けされた結果（タイトル、URL、スニペット、要約、任意で本文）を返します。最新情報の調査や事実確認に使います。DeepSeek 検索サービスを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹을 검색해 순위가 매겨진 결과(제목, URL, 스니펫, 요약, 선택적 본문)를 반환합니다. 최신 정보 조회와 사실 확인에 사용합니다. DeepSeek 검색 서비스를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "联网搜索网页并返回排序结果（标题、链接、摘要、可选正文）。适合查询最新信息与事实核对。由 DeepSeek 搜索服务提供。"
          }
        }
      }
    },
