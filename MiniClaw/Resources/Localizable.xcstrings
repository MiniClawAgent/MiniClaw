    "continue_session_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a message to the selected MiniClaw conversation (can attach files). Can wait for the Agent to finish and return the reply, or return immediately and notify later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した MiniClaw 会話にメッセージを送信します（ファイル添付可）。エージェントの完了を待って返信を取得するか、即時に返って後で通知することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 MiniClaw 대화에 메시지를 보냅니다(파일 첨부 가능). 에이전트 완료를 기다려 응답을 받거나 즉시 반환 후 나중에 알림을 받을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向选中的 MiniClaw 会话发送消息（可附文件）。可等待智能体完成并返回回复内容，或立即返回稍后通知。"
          }
        }
      }
    },
