    "browser_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser CLI wrapper. Put all action parameters under params. navigate must provide params.url; max_length is only used by get_readable. Every call must provide activity, a 6-16 character Chinese description of the concrete business action."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザ CLI ラッパー。操作パラメータは params に統一して入れます。navigate は params.url が必須、max_length は get_readable 専用です。毎回 activity（具体的な業務内容を表す 6-16 字の中国語説明）を指定する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 CLI 래퍼. 작업 매개변수는 params에 넣습니다. navigate는 params.url 필수, max_length는 get_readable 전용. 호출 시마다 activity(구체적 업무를 나타내는 6-16자 중국어 설명)를 제공해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器 CLI 封装。操作参数统一放入 params。navigate 必须提供 params.url；max_length 仅用于 get_readable。每次调用必须提供 activity，用6-16字中文描述当前具体业务行为。"
          }
        }
      }
    },
