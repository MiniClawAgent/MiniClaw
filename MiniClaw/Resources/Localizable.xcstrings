    "remote_host_param_action" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operation: setup (check openssh/key in iSH and output install + target-OS setup guide), connect (verify connectivity and save connection params), exec (run a command on a saved remote host), list (list saved hosts), discover (zero-config discovery of all SSH devices on the LAN), discover (zero-config discovery of all SSH devices on the LAN)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作：setup（iSH 内の openssh/鍵を確認しインストールと対象 OS の設定手順を提示）、connect（接続を検証しパラメータを保存）、exec（保存済みホストでコマンド実行）、list（保存済みホスト一覧）, discover（LAN 内の SSH デバイスを設定なしで検出）, discover（LAN 内の SSH デバイスを設定なしで検出）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업: setup(iSH 내 openssh/키 점검 후 설치 및 대상 OS 설정 가이드 출력), connect(연결 검증 및 파라미터 저장), exec(저장된 호스트에서 명령 실행), list(저장된 호스트 목록), discover(LAN 내 SSH 장치를 설정 없이 검출), discover(LAN 내 SSH 장치를 설정 없이 검출)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作：setup（检查 iSH 内 openssh/密钥并输出安装与目标机配置指引）、connect（验证连通并保存连接参数）、exec（在已保存的远程主机上执行命令）、list（列出已保存的主机）、discover（零配置发现局域网内所有 SSH 设备）、discover（零配置发现局域网内所有 SSH 设备）"
          }
        }
      }
    },
    "remote_host_param_command" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command to run on the remote host (for exec), e.g. \"say hello\" (macOS) or \"uname -a\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートホストで実行するコマンド（exec 用）。例: \"say こんにちは\"（macOS）や \"uname -a\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 호스트에서 실행할 명령(exec용). 예: \"say 안녕\"(macOS) 또는 \"uname -a\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在远程主机上执行的命令（exec 用），如 \"say 你好\"（macOS）或 \"uname -a\""
          }
        }
      }
    },
    "remote_host_param_host" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host address (for connect): IP or domain, e.g. 192.168.10.107; omit on connect for automatic Bonjour discovery / LAN probing; omit on connect for automatic Bonjour discovery / LAN probing"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストアドレス（connect 用）：IP またはドメイン、例: 192.168.10.107; connect では省略可——Bonjour 検出/LAN 自動探測; connect では省略可——Bonjour 検出/LAN 自動探測"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 주소(connect용): IP 또는 도메인, 예: 192.168.10.107; connect에서 생략 가능——Bonjour 검출/LAN 자동 탐색; connect에서 생략 가능——Bonjour 검출/LAN 자동 탐색"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
