    "after_uninstalling_the_ai_will_no_longer_be_able_to_access_this_folder_via_its_virtual_path_the_files_in_the_external_folder_itself_will_not_be_deleted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After uninstalling “%@”, the AI will no longer be able to access this folder via its virtual path. The files in the external folder itself will not be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をアンインストールすると、AI は仮想パスからこのフォルダにアクセスできなくなります。外部フォルダ内のファイル自体は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」을(를) 제거하면 AI는 가상 경로로 이 폴더에 더 이상 접근할 수 없게 됩니다. 외부 폴더의 실제 파일은 삭제되지 않습니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载「%@」后，AI 将无法通过虚拟路径访问此文件夹。外部文件夹本身的文件不会被删除。"
          }
        }
      }
    },
