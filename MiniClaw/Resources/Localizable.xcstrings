    "you_need_to_connect_a_model_before_chatting_go_to_ai_providers_to_add_a_provider_and_enter_your_api_key" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need to connect a model before chatting. Go to “AI Providers” to add a provider and enter your API Key."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話を始めるにはモデルを接続する必要があります。「AI プロバイダー」でプロバイダーを追加し、API Key を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화하려면 먼저 모델을 연결해야 합니다. ‘AI 제공업체’로 이동해 제공업체를 추가하고 API Key를 입력하세요。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要先接入模型才能完成对话。请前往「AI 服务商」添加服务商并填写 API Key。"
          }
        }
      }
    },
