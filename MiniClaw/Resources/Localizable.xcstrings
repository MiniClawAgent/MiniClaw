    "core_image_read" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✅ Image attached with this message (%d x %d px) — view it directly to judge UI state, describe the scene, or locate elements. Only use apple-vision text_coords mode when you need precise pixel coordinates (e.g. click targeting)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✅ 画像はこのメッセージに添付済み（%d x %d px）——画面状態の判断や描写は直接ご覧ください。正確なピクセル座標（クリック位置）が必要な場合のみ apple-vision の text_coords を使用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✅ 이미지가 이 메시지에 첨부되었습니다(%d x %d px) — 화면 상태 판단·장면 묘사·요소 찾기는 직접 보세요. 정확한 픽셀 좌표(클릭 위치)가 필요할 때만 apple-vision의 text_coords를 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
