    "context_window_and_max_output_leave_blank_or_enter_0_to_use_the_provider_default_once_set_your_values_take_effect_and_actually_constrain_requests" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context window and max output: leave blank or enter 0 to use the provider default; once set, your values take effect and actually constrain requests."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストウィンドウと最大出力：空欄または 0 の場合は各プロバイダのデフォルトで動作します。入力すると設定値が適用され、実際にリクエストが制限されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트 창 및 최대 출력: 비워두거나 0을 입력하면 공급업체 기본값으로 작동합니다. 입력하면 설정값이 적용되어 실제로 요청이 제한됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文窗口与最大输出：留空/填 0 时按厂商默认运行；填写后按你的设置生效并实际约束请求。"
          }
        }
      }
    },
