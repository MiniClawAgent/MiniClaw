    "location_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device location and geocoding. Action=current returns the current coordinates (optionally with an address); geocode turns an address into coordinates; reverse_geocode turns coordinates into an address. Requires the location permission granted in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の位置情報とジオコーディング。current は現在の座標を返します（住所を付加可能）。geocode は住所を座標に、reverse_geocode は座標を住所に変換します。設定で位置情報の権限が許可されている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 위치 및 지오코딩. current 는 현재 좌표를 반환하며(주소 포함 가능), geocode 는 주소를 좌표로, reverse_geocode 는 좌표를 주소로 변환합니다. 설정에서 위치 권한이 허용되어 있어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备定位与地理编码。current 返回当前坐标（可附带地址）；geocode 把地址转成坐标；reverse_geocode 把坐标转成地址。需要在设置中已授予定位权限。"
          }
        }
      }
    },
    "location_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location services are turned off system-wide. Ask the user to enable them in Settings - Privacy & Security - Location Services."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報サービスがシステム全体で無効です。「設定 → プライバシーとセキュリティ → 位置情報サービス」で有効にするよう案内してください。"
