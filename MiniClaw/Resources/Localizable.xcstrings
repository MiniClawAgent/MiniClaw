    "when_background_run_is_on_live_island_live_activity_shows_task_progress_live_activity_controls_rendering_on_the_island_and_lock_screen_picture_in_picture_shows_the_running_task_icon_title_progress_as_a_persistent_pip_window_after_you_leave_the_chat_page" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When \"Background Run\" is on, Live Island / Live Activity shows task progress; \"Live Activity\" controls rendering on the island and lock screen; \"Picture in Picture\" shows the running task (icon / title / progress) as a persistent PiP window after you leave the chat page."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バックグラウンド実行」をオンにすると、Live Island / Live Activity でタスクの進捗を表示します。「リアルタイムアクティビティ」はアイランドとロック画面での描画を制御します。「ピクチャ・イン・ピクチャ」をオンにすると、チャット画面を離れた後も実行中のタスク（アイコン / タイトル / 進捗）を PiP で常駐表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「백그라운드 실행」을 켜면 Live Island / Live Activity로 작업 진행 상황을 표시합니다. 「실시간 활동」은 아일랜드와 잠금 화면 렌더링을 제어합니다. 「화면 속 화면」을 켜면 채팅 화면을 나가도 실행 중인 작업(아이콘 / 제목 / 진행률)이 PiP로 상주 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「后台运行」开启后，运用灵动岛 / 实时活动显示任务进度；「实时活动」控制是否在灵动岛与锁屏渲染；「画中画」开启后，退出会话页即以画中画常驻显示运行中的任务（图标 / 会话标题 / 执行进度）。"
          }
        }
      }
    },
    "when_background_running_is_on_task_progress_is_shown_via_dynamic_island_live_activities_live_activity_controls_whether_it_renders_on_the_dynamic_island_and_lock_screen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When “Background Running” is on, task progress is shown via Dynamic Island / Live Activities; “Live Activity” controls whether it renders on the Dynamic Island and Lock Screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バックグラウンド実行」をオンにすると、Dynamic Island / ライブアクティビティでタスクの進行状況が表示されます。「ライブアクティビティ」は、Dynamic Island とロック画面に表示するかを制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「백그라운드 실행」을 켜면 Dynamic Island / 실시간 활동으로 작업 진행 상황이 표시됩니다. 「실시간 활동」은 Dynamic Island와 잠금 화면에 렌더링할지 제어합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「后台运行」开启后，运用灵动岛 / 实时活动显示任务进度；「实时活动」控制是否在灵动岛与锁屏渲染。"
          }
        }
      }
    },
    "when_enabled_environment_variable_values_in_shell_output_will_be_masked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, environment variable values in Shell output will be masked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、Shell の出力にある環境変数の値がマスクされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 Shell 출력의 환경변수 값이 가려집니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，Shell 输出中的环境变量值将被掩码遮蔽。"
          }
        }
      }
    },
    "when_enabled_session_data_configuration_and_skills_will_sync_across_devices_via_icloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, session data, configuration, and Skills will sync across devices via iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、セッションデータ、設定、スキルが iCloud を介してデバイス間で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 세션 데이터, 설정, 스킬이 iCloud를 통해 기기 간 동기화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，会话数据、配置和 Skill 将通过 iCloud 在设备间同步。"
          }
        }
      }
    },
    "when_enabled_the_agent_will_ask_for_your_confirmation_before_each_tool_call_file_browser_shell_etc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the Agent will ask for your confirmation before each tool call (file/browser/shell, etc.)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、エージェントは各ツール呼び出し（ファイル/ブラウザ/シェルなど）の前に確認を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 에이전트가 도구를 호출하기 전(파일/브라우저/셸 등)에 확인을 요청합니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，Agent 每次调用工具（文件/浏览器/Shell 等）前会先征求你的确认。"
          }
        }
      }
    },
    "when_off_the_agent_no_longer_dispatches_subagents_and_is_told_this_capability_has_been_turned_off_by_the_user" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the agent no longer dispatches subagents and is told this capability has been turned off by the user."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにするとエージェントはサブエージェントを派生成せず、その能力がユーザーによって無効化されたと伝えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 에이전트가 서브에이전트를 파견하지 않으며 해당 기능이 사용자에 의해 꺼졌다는 사실을 알게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后智能体不再派发子代理，并被告知该能力已被用户关闭"
          }
        }
      }
    },
    "when_using_azure_openai_authentication_append_the_full_azure_endpoint_including_query_parameters_in_the_custom_api" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
