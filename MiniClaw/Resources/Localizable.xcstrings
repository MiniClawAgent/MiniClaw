    "loop_tool_image_injected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(The screenshot/image returned by the tool is attached with this message — to judge UI state or describe the scene just view it directly, no OCR needed; only use apple-vision text_coords mode when you need precise pixel coordinates for clicking.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（ツールが返したスクリーンショット/画像はこのメッセージに添付済み——画面状態の判断や描写は直接ご覧ください。OCR は不要です。クリック用の正確なピクセル座標が必要な場合のみ apple-vision の text_coords を使用。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(도구가 반환한 스크린샷/이미지가 이 메시지에 첨부되어 있습니다 — 화면 상태 판단이나 장면 묘사는 그대로 보면 되며 OCR이 불필요합니다. 클릭용 정확한 픽셀 좌표가 필요할 때만 apple-vision의 text_coords 모드를 사용하세요.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（以上是工具返回的截图/图片，已随本消息附上——判断界面状态、描述画面直接看图即可，无需 OCR；仅当需要精确像素坐标进行点击时，才用 apple-vision 的 text_coords 模式。）"
          }
        }
      }
    },
