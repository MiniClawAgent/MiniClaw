    "bc_js_timeout" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript execution timed out (%lds): the page may still be loading or the script is stuck; finish navigate first, and wait_for_dom_stable if needed, before reading content"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript の実行がタイムアウトしました（%lds）：ページがまだ読み込み中かスクリプトが固まっている可能性があります。先に navigate を完了させ、必要なら wait_for_dom_stable を実行してからコンテンツを取得してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript 실행 시간 초과(%lds): 페이지가 아직 로딩 중이거나 스크립트가 멈췄을 수 있습니다. 먼저 navigate를 완료하고 필요하면 wait_for_dom_stable 후 콘텐츠를 가져오세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript 执行超时（%lds）：页面可能仍在加载或脚本卡死，请先 navigate 完成、必要时 wait_for_dom_stable 后再取内容"
          }
        }
      }
    },
    "bc_nav_timeout_json" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
