    "vision_analyze_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze images locally with the Apple Vision framework; no network needed. Recognizes scene/object classification, text content (OCR), face count, etc. When the user sends an image but the current model has no native vision input, prefer calling this tool to understand the image. Supports jpg/png/gif/webp/heic and other common formats. path can be a /var/MiniClaw/... absolute path, or a miniclaw://browser/... link returned by the browser tool's screenshot/fetch (auto-converted)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple Vision 框架本地分析图片，无需网络。可识别图片中的场景/物体分类、文字内容(OCR)、人脸数量等。当用户发送了图片但当前模型不支持原生视觉输入时，应优先调用此工具来理解图片内容。支持 jpg/png/gif/webp/heic 等常见格式。path 可为 /var/MiniClaw/... 绝对路径，或浏览器工具截图/fetch 返回的 miniclaw://browser/... 链接（会自动转换）。"
          }
        }
      }
    },
