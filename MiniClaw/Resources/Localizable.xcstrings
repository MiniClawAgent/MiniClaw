    "records_app_debug_logs_by_day_errors_freezes_infinite_loops_crashes_logging_stops_when_the_switch_is_off_swipe_left_to_delete_a_single_log" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records app debug logs by day (errors / freezes / infinite loops / crashes). Logging stops when the switch is off. Swipe left to delete a single log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのデバッグログを日単位で記録します（エラー／フリーズ／無限ループ／クラッシュ）。スイッチをオフにすると記録が停止します。左にスワイプで個別のログを削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 디버그 로그를 날짜별로 기록합니다(오류 / 멈춤 / 무한 루프 / 강제 종료). 스위치를 끄면 기록이 중지됩니다. 왼쪽으로 스와이프하면 개별 로그를 삭제할 수 있습니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按天记录应用调试日志（报错 / 卡死 / 死循环 / 闪退）。关闭开关后将停止记录。左滑可删除单个日志。"
          }
        }
      }
    },
