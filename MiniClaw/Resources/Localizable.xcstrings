          "stringUnit" : {
            "state" : "translated",
            "value" : "请压缩以下对话记录，仅保留关键决策、用户意图、已完成的任务、重要结论与未决事项，用简洁中文输出，不要添加额外内容：\\n\\n"
          }
        }
      }
    },
