    "file_read_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read a UTF-8 text file. Supports offset/limit paging or tail to read trailing lines; rejects binary files. The path must be an absolute /var/MiniClaw/... path."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTF-8 テキストファイルを読み取ります。offset/limit によるページングや tail による末尾読み取りに対応。バイナリファイルは拒否します。パスは /var/MiniClaw/... の絶対パスである必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTF-8 텍스트 파일을 읽습니다. offset/limit 페이징 또는 tail로 끝 줄 읽기를 지원합니다. 바이너리 파일은 거부합니다. 경로는 /var/MiniClaw/... 절대 경로여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取 UTF-8 文本文件。支持 offset/limit 分页或 tail 读取末尾行；拒绝二进制文件。路径必须为 /var/MiniClaw/... 绝对路径。"
          }
        }
      }
    },
