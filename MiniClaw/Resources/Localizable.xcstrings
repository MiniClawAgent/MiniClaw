    "memory_search_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search memory. long_term searches only memory/MEMORY.md (inside the app sandbox); daily searches only today's daily memory; all searches MEMORY.md and all dated memories. GLOBAL.md is the rules file and is not part of memory search."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索记忆。long_term 仅搜索 memory/MEMORY.md（App 沙盒内）；daily 仅搜索今日每日记忆；all 搜索 MEMORY.md 与所有日期记忆。GLOBAL.md 是规则文件，不属于记忆搜索。"
          }
        }
      }
    },
    "memory_toggle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory toggle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリのオン/オフ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 토글"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆开关"
          }
        }
      }
    },
    "memory_write_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write or modify memory. With target=long_term, only write memory/MEMORY.md (inside the app sandbox); with target=daily, write today's YYYY-MM-DD.md. mode=append adds (default); mode=replace overwrites entirely; mode=edit replaces old_string with new_string (targeted line edit). Never write long-term memory into GLOBAL.md; GLOBAL.md is the rules file. Do not record passwords, API Keys, or other sensitive info. Do not modify files under memory/ with file_edit/file_write."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入或修改记忆。target=long_term 时只写 memory/MEMORY.md（App 沙盒内）；target=daily 时写今日 YYYY-MM-DD.md。mode=append 追加（默认）；mode=replace 整体覆盖；mode=edit 把 old_string 替换为 new_string（定点修改某一行）。不得把长期记忆写入 GLOBAL.md；GLOBAL.md 是规则文件。不记录密码、API Key 等敏感信息。禁止用 file_edit/file_write 修改 memory/ 下的文件。"
          }
        }
      }
    },
