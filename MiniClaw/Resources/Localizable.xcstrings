    "files_unsupported_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[File] The user attached %d file(s) (%@), but the current model cannot read them directly. Use the read_document tool to understand the user's intent. File paths: \"%@\""
          }
