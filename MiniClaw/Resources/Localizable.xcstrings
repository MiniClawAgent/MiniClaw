    "file_edit_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exact string replacement (old_string → new_string). Only modifies existing text files; write-directory restrictions are the same as file_write (including external mounts with \"Allow write\" enabled in Settings→Mounts). The path must be an absolute /var/MiniClaw/... path."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确字符串替换（old_string → new_string）。仅修改已存在的文本文件；写入目录限制与 file_write 相同（含已在「设置 → 挂载」开启「允许写入」的外部挂载文件夹）。路径必须为 /var/MiniClaw/... 绝对路径。"
          }
        }
      }
    },
