          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ",\"error\":\"내비게이션 시간 초과(15s 동안 완료 콜백 없음): 페이지가 로딩 중이거나 접근 불가일 수 있습니다. 다른 URL이나 경로를 시도하세요\""
