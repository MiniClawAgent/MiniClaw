    "stdio_transport_is_only_available_on_macos_simulator_the_ios_sandbox_cannot_launch_local_processes_var_expansion_is_supported_in_command_and_arguments" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STDIO transport is only available on macOS / Simulator; the iOS sandbox cannot launch local processes. ${VAR} expansion is supported in command and arguments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STDIO トランスポートは macOS / Simulator のみ利用可能。iOS サンドボックスではローカルプロセスを起動できません。コマンドと引数で ${VAR} 展開に対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STDIO 전송은 macOS/시뮬레이터에서만 사용 가능합니다. iOS 샌드박스는 로컬 프로세스를 실행할 수 없습니다. 명령과 인자에서 ${VAR} 확장을 지원합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STDIO 传输仅在 macOS / Simulator 可用；iOS 沙箱不支持拉起本地进程。命令与参数支持 ${VAR} 展开。"
          }
        }
      }
    },
