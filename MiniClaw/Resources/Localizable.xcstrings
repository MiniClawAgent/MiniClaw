    "select_a_created_model_group_for_different_purposes_choose_none_to_leave_it_unspecified" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a created model group for different purposes; choose \"None\" to leave it unspecified."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用途に応じて作成済みのモデルグループを選択します。「なし」を選ぶと指定しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용도에 따라 생성된 모델 그룹을 선택합니다. \"없음\"을 선택하면 지정하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为不同用途选择已创建的模型组；选择“无”表示不指定。"
          }
        }
      }
    },
    "select_a_folder_via_the_ios_files_app_to_mount_into_miniclaw_read_only_by_default_the_agent_can_read_its_contents_via_var_miniclaw_mounts_name_to_let_the_agent_write_enable_the_allow_write_switch_on_that_mount_writes_are_persisted_to_the_external_folder_so_please_be_careful_mount_info_remains_valid_after_the_app_restarts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a folder via the iOS Files app to mount into MiniClaw. Read-only by default: the Agent can read its contents via `/var/MiniClaw/mounts/<name>/…`; to let the Agent write, enable the “Allow Write” switch on that mount (writes are persisted to the external folder, so please be careful). Mount info remains valid after the app restarts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS のファイル App からフォルダを選んで MiniClaw にマウントします。既定は読み取り専用です。Agent は `/var/MiniClaw/mounts/<名称>/…` 経由で内容を読み取れます。Agent に書き込みを許可するには、該当のマウントで「書き込みを許可」スイッチをオンにしてください（書き込みは外部フォルダに実際に保存されるためご注意ください）。マウント情報は App の再起動後も有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 파일 App을 통해 폴더를 선택하여 MiniClaw에 마운트합니다. 기본은 읽기 전용입니다. Agent는 `/var/MiniClaw/mounts/<이름>/…` 경로로 내용을 읽을 수 있습니다. Agent가 쓰도록 하려면 해당 마운트에서 '쓰기 허용' 스위치를 켜세요(쓰기는 외부 폴더에 실제로 저장되므로 주의하세요). 마운트 정보는 앱 재시작 후에도 유효합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 iOS 文件 App 选择一个文件夹挂载到 MiniClaw。默认只读：Agent 可通过 `/var/MiniClaw/mounts/<名称>/…` 读取其中内容；如需让 Agent 写入，请在对应挂载上开启「允许写入」开关（写入会真实落盘到外部文件夹，请谨慎）。挂载信息在 App 重启后依然有效。"
          }
        }
      }
    },
