    "clear_cache" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Cache"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュをクリア"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시 지우기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理缓存"
          }
        }
      }
    },
    "clear_cache_clears_only_the_browser_cache_shared_area_and_each_session_clean_old_attachments_deletes_attachments_older_than_the_cleanup_period_clear_all_data_deletes_all_per_session_isolated_files_and_local_working_data_settings_models_and_skills_are_unaffected_runtime_and_crash_logs_are_controlled_by_the_switch_on_the_logs_page_and_are_not_deleted_here" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Clear Cache” clears only the browser cache (shared area and each session); “Clean Old Attachments” deletes attachments older than the cleanup period; “Clear All Data” deletes all per-session isolated files and local working data (settings, models, and skills are unaffected). Runtime and crash logs are controlled by the switch on the Logs page and are not deleted here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キャッシュをクリア」はブラウザキャッシュのみを削除します（共有領域と各セッション）；「古い添付をクリア」はクリーンアップ周期を超えた添付を削除します；「すべてのデータをクリア」は全セッションの分離ファイルとローカル作業データを削除します（設定・モデル・スキルは影響を受けません）。実行ログとクラッシュログは「ログ」ページのスイッチで制御され、ここでは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“캐시 지우기”는 브라우저 캐시만 정리합니다(공유 영역 및 각 세션). “오래된 첨부 지우기”는 정리 주기를 넘긴 첨부를 삭제합니다. “모든 데이터 지우기”는 모든 세션 격리 파일과 로컬 작업 데이터를 삭제합니다(설정·모델·스킬은 영향받지 않습니다). 실행 로그와 크래시 로그는 “로그” 페이지의 스위치로 제어되며 여기서는 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「清理缓存」仅清理浏览器缓存（共享区与各会话）；「清理旧附件」删除超过清理周期的附件；「清除所有数据」删除全部会话隔离文件与本地工作数据（设置、模型与技能不受影响）。运行日志与崩溃日志由「日志」页的开关控制，此处不删除。"
          }
        }
      }
    },
    "clear_cache_deletes_runtime_logs_and_browser_cache_directories_clean_old_attachments_deletes_attachments_older_than_the_cleanup_period_clear_all_data_deletes_all_session_isolated_files_and_local_working_data_settings_models_and_skills_are_unaffected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Clear Cache” deletes runtime logs and browser/cache directories; “Clean Old Attachments” deletes attachments older than the cleanup period; “Clear All Data” deletes all session-isolated files and local working data (settings, models and skills are unaffected)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キャッシュをクリア」は実行ログとブラウザ/キャッシュディレクトリを削除します。「古い添付をクリア」はクリーンアップ周期を超えた添付を削除します。「すべてのデータをクリア」は全セッション分離ファイルとローカル作業データを削除します（設定・モデル・スキルは影響を受けません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘캐시 지우기’는 실행 로그와 브라우저/캐시 디렉터리를 삭제합니다. ‘오래된 첨부 지우기’는 정리 주기를 넘긴 첨부를 삭제합니다. ‘모든 데이터 지우기’는 모든 세션 격리 파일과 로컬 작업 데이터를 삭제합니다(설정·모델·스킬은 영향을 받지 않음)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「清理缓存」删除运行日志与浏览器/缓存目录；「清理旧附件」删除超过清理周期的附件；「清除所有数据」删除全部会话隔离文件与本地工作数据（设置、模型与技能不受影响）。"
          }
        }
      }
    },
