    "list_dir_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "List directory contents (read-only, non-recursive). Lists any subdirectory under /var/MiniClaw/, including external folders mounted in Settings→Mounts (paths like /var/MiniClaw/mounts/<name>/). Returns file/subdirectory names, one per line. Reading mounted content does NOT depend on shell/iSH: use list_dir to see what is mounted, then file_read for specific files. The path must be an absolute /var/MiniClaw/... path."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出目录内容（只读，不递归）。可列出 /var/MiniClaw/ 下任意子目录，包括「设置→挂载」中挂载的外部文件夹（路径形如 /var/MiniClaw/mounts/<name>/）。返回该目录下的文件名/子目录名（每行一个）。读取挂载内容**不依赖 shell/iSH**：先 list_dir 看挂载里有什么，再用 file_read 读具体文件。路径必须为 /var/MiniClaw/... 绝对路径。"
          }
        }
      }
    },
    "listening_release_to_finish" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
