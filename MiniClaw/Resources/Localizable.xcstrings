    "core_bash_syntax_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n<system-reminder>Detected bash-specific syntax (%@); this executor uses busybox sh and may be incompatible. If execution fails, rewrite it in POSIX sh syntax, or install bash with `apk add bash` and run via `bash -lc`.</system-reminder>"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n<system-reminder>bash 固有の構文（%@）を検出しました。この実行器は busybox sh のため互換性がない可能性があります。実行が失敗する場合は POSIX sh 構文に書き直すか、apk add bash で bash をインストールして bash -lc で実行してください。</system-reminder>"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n<system-reminder>bash 전용 구문(%@)이 감지되었습니다. 이 실행기는 busybox sh라 호환되지 않을 수 있습니다. 실행에 실패하면 POSIX sh 구문으로 고치거나 apk add bash로 bash를 설치한 뒤 bash -lc로 실행하세요.</system-reminder>"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n<system-reminder>检测到 bash 特有语法（%@），本执行器为 busybox sh 可能不兼容；如执行异常请改写为 POSIX sh 语法，或先用 apk add bash 安装 bash 后以 bash -lc 执行。</system-reminder>"
          }
        }
      }
    },
