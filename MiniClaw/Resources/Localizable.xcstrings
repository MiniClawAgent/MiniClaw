    "sys_empty_reply_continue" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(You only produced reasoning above and no visible reply. Based on that reasoning, write the complete user-facing answer now.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（上記では思考のみが出力され、本文となる回答が出力されていません。その思考に基づき、ユーザーに向けた完全な回答を本文として出力してください。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(위에서 추론만 출력되고 본문 답변이 없습니다. 해당 추론을 바탕으로 사용자에게 완전한 답변을 본문으로 출력하세요.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（你刚才只进行了思考，没有输出任何正文回答。请基于上面的思考给出面向用户的完整正文回答。）"
          }
        }
      }
    },
    "sys_interrupted_reply_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n[System note: the above reply ended early due to interruption or error; content is incomplete and terminated. Do not continue or complete it; respond directly to the user's latest message.]"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n[システム通知：上記の返信は中断またはエラーにより早期終了しており、内容は不完全かつ終了済みです。続けたり補完したりせず、ユーザーの最新メッセージに直接応答してください。]"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n[시스템 안내: 위 답변은 중단 또는 오류로 조기 종료되어 내용이 불완전하며 종료되었습니다. 이어쓰거나 보완하지 말고 사용자의 최신 메시지에 바로 응답하세요.]"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n[系统提示：以上回复因被中断或出错而提前结束，内容不完整且已终止，请勿续写或补全，直接响应用户的最新消息。]"
          }
        }
      }
    },
