    "file_edit_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exact string replacement (old_string → new_string). Only modifies existing text files; write-directory restrictions are the same as file_write (including external mounts with \"Allow write\" enabled in Settings→Mounts). The path must be an absolute /var/MiniClaw/... path."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な文字列置換（old_string → new_string）。既存のテキストファイルのみ修正対象。書き込みディレクトリの制限は file_write と同じ（「設定 → マウント」で「書き込み許可」を有効にした外部マウントを含む）。パスは /var/MiniClaw/... の絶対パスである必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확한 문자열 치환(old_string → new_string). 기존 텍스트 파일만 수정합니다. 쓰기 디렉터리 제한은 file_write와 동일합니다('설정 → 마운트'에서 '쓰기 허용'을 켠 외부 마운트 포함). 경로는 /var/MiniClaw/... 절대 경로여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确字符串替换（old_string → new_string）。仅修改已存在的文本文件；写入目录限制与 file_write 相同（含已在「设置 → 挂载」开启「允许写入」的外部挂载文件夹）。路径必须为 /var/MiniClaw/... 绝对路径。"
          }
        }
      }
    },
