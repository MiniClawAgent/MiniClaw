    "read_document_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read file content from user attachments. Supports plain text/code/Markdown/JSON/CSV/XML/HTML/TXT etc. (UTF-8) and PDF (auto text extraction); supports offset/limit paging or tail. Office binaries (docx/xlsx/pptx etc.) are not supported for on-device text extraction yet; prompt the user to export to PDF/TXT. The path must be an absolute /var/MiniClaw/... path. When the user sends a file but the current model cannot read it directly, prefer calling this tool to understand the user's intent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取用户附件中的文件内容。支持纯文本/代码/Markdown/JSON/CSV/XML/HTML/TXT 等（UTF-8）与 PDF（自动抽取文本）；支持 offset/limit 分页或 tail 读取末尾。Office 二进制（docx/xlsx/pptx 等）暂不支持端侧文本抽取，会提示用户导出为 PDF/TXT。路径必须为 /var/MiniClaw/... 绝对路径。当用户发送了文件但当前模型不支持直接读取时，应优先调用本工具读取文件来理解用户意图。"
          }
        }
      }
    },
