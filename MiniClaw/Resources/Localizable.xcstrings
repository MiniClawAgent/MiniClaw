          }
        }
      }
    },
    "after_starting_a_conversation_this_will_accumulate_the_session_s_token_usage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After starting a conversation, this will accumulate the session's Token usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
