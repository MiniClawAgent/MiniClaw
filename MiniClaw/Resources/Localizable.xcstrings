    "remote_host_discover_next" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP changes are handled automatically: connect/exec re-resolve the device's current address."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP 変更は自動対応：connect/exec はデバイスの現在アドレスを再解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP 변경은 자동 처리: connect/exec가 장치의 현재 주소를 다시 확인합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP 变动无需担心：connect/exec 会自动重新解析设备当前地址。"
          }
        }
      }
    },
    "remote_host_discover_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: mDNS discovery may find nothing across subnets or when Local Network permission is not granted — that does NOT mean the target is unreachable. Use action=connect with the target IP directly, or let the tool auto-probe the subnet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：mDNS 検出はサブネット越えやローカルネットワーク権限未付与では見つかりません——対象に到達不能という意味ではありません。action=connect で IP を直接渡すか、ツールにサブネットを自動探測させてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: mDNS 검색은 서브넷 간 또는 로컬 네트워크 권한 미허용 시 실패할 수 있습니다——대상에 접근 불가를 의미하지 않습니다. action=connect로 IP를 직접 전달하거나 도구가 서브넷을 자동 탐색하게 하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明：mDNS 发现在「跨网段」或「本地网络权限未授予」时会扫不到——这不代表目标机不可达。直接用 action=connect 传目标机 IP，或让工具自动探测网段即可连接。"
          }
        }
      }
    },
    "remote_host_discover_probe_header" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAN probe found the following hosts with port 22 open (usable directly as connect's host):"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAN 探測で 22 ポート開放ホストを検出（connect の host としてそのまま使用可）："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAN 탐색으로 22 포트가 열린 호스트 발견(connect의 host로 바로 사용 가능):"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "局域网探测发现以下主机的 22 端口开放（可直接作为 connect 的 host）："
          }
        }
      }
    },
    "remote_host_exec_lan_candidates" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target host unreachable. These LAN hosts accept SSH logins: %1$@. Verify which one is the actual target (check the OS platform to avoid the wrong machine), then update it with connect (name + host) and retry exec."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続先ホストに到達できません。LAN 内で SSH ログイン可能なホスト: %1$@。どれが目標か確認し（誤接続防止のため OS プラットフォームを照合）してから、connect（name + host）でアドレスを更新し、exec を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 호스트에 연결할 수 없습니다. LAN에서 SSH 로그인 가능한 호스트: %1$@. 어느 것이 대상인지 확인(잘못된 머신 방지를 위해 OS 플랫폼 대조)한 후 connect(name + host)로 주소를 갱신하고 exec를 재시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标主机不可达。局域网内这些主机可 SSH 登录：%1$@。请核对哪台才是目标（对照系统平台，防止连错机器），确认后用 connect(name+host) 更新地址，再重试 exec。"
          }
        }
      }
    },
    "remote_host_exec_need_command" : {
      "extractionState" : "manual",
      "localizations" : {
