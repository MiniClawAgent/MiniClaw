    "send_a_message_to_the_selected_miniclaw_session_attachments_allowed_wait_for_the_agent_to_finish_and_return_the_reply_or_return_immediately_and_get_notified_later" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a message to the selected MiniClaw session (attachments allowed). Wait for the agent to finish and return the reply, or return immediately and get notified later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した MiniClaw セッションにメッセージを送信（添付可）。エージェントの完了を待って返信を返すか、すぐに返して後で通知を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 MiniClaw 세션에 메시지 전송(첨부 가능). 에이전트 완료를 기다렸다가 답변을 받거나, 즉시 반환하고 나중에 알림을 받을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向选中的 MiniClaw 会话发送消息（可附文件）。可等待智能体完成并返回回复内容，或立即返回稍后通知。"
          }
        }
      }
    },
    "send_a_simulated_message_and_measure_the_first_token_latency" : {
      "extractionState" : "manual",
