    "skill_load_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load the full SKILL.md body of an enabled skill on demand. The system prompt lists the name and description of every enabled skill for your judgment; when a skill is relevant to the current task and you need to follow its instructions, call this tool to load its body. After loading, strictly follow the skill's workflow and output format in subsequent messages. name must be one of the skill names listed under \"Enabled Skills\" in the system prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なスキルの SKILL.md 本文をオンデマンドで読み込みます。system プロンプトにはすべての有効スキルの name と description が列挙されています。あるスキルが現在のタスクに関連し、その指示に従う必要があるときに本ツールで本文を読み込んでください。読み込み後の会話では、そのスキルのワークフローと出力形式に厳密に従ってください。name は system の「有効なスキル」に列挙されたスキル名のいずれかである必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화된 스킬의 SKILL.md 본문을 온디맨드로 로드합니다. system 프롬프트에는 모든 활성 스킬의 name과 description이 나열되어 있습니다. 스킬이 현재 작업과 관련되고 그 지침을 따라야 할 때 이 도구로 본문을 로드하세요. 로드 후 대화에서는 해당 스킬의 워크플로와 출력 형식을 엄격히 따르세요. name은 system의 '활성화된 스킬'에 나열된 스킬 이름 중 하나여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按需加载某个已启用技能的完整 SKILL.md 正文。system 提示已列出全部启用技能的 name 与 description 供你判断；当某条技能与当前任务相关、你需要遵循其指令时，调用本工具加载其正文。加载后请在后续对话中严格遵循该技能的工作流与输出格式。name 必须是 system 中「已启用技能」列出的技能名之一。"
          }
        }
      }
    },
    "skill_loaded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill \"%@\" loaded. Its full instructions have been injected into this session's system prompt; follow its workflow and output format in subsequent messages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキル「%@」を読み込みました。完全な指示本文がこのセッションの system プロンプトに注入されました。以降の会話ではそのワークフローと出力形式に厳密に従ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킬 '%@'를 로드했습니다. 전체 지침 본문이 이 세션의 system 프롬프트에 주입되었습니다. 이후 대화에서는 워크플로와 출력 형식을 엄격히 따르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加载技能「%@」。其完整指令正文已注入本会话 system 提示的易变段，后续对话请严格遵循其工作流与输出格式。"
          }
        }
      }
    },
