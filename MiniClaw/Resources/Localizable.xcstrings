    "clear_browser_cache" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear browser cache"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザキャッシュをクリア"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 캐시 지우기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理浏览器缓存"
          }
        }
      }
    },
    "clear_browser_cache_clears_web_caches_webkit_cache_urlcache_shared_browser_data_clear_session_cache_clears_rebuildable_cache_data_in_each_session_session_browser_data_subagent_runtime_records_without_affecting_conversation_content_clear_old_attachments_deletes_attachments_older_than_the_cleanup_period_clear_all_data_deletes_all_session_isolated_files_and_local_working_data_settings_models_and_skills_are_unaffected_run_logs_and_crash_logs_are_controlled_by_toggles_on_the_logs_page" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Clear browser cache\" clears web caches (WebKit cache, URLCache, shared browser data); \"Clear session cache\" clears rebuildable cache data in each session (session browser data, subagent runtime records) without affecting conversation content; \"Clear old attachments\" deletes attachments older than the cleanup period; \"Clear all data\" deletes all session-isolated files and local working data (settings, models, and skills are unaffected). Run logs and crash logs are controlled by toggles on the Logs page."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ブラウザキャッシュをクリア」は Web キャッシュ（WebKit キャッシュ、URLCache、共有ブラウザデータ）を削除；「セッションキャッシュをクリア」は各セッション内の再構築可能なキャッシュ（セッションブラウザデータ、サブエージェント実行記録）を削除し、会話内容には影響しません；「古い添付をクリア」は期間を超えた添付ファイルを削除；「すべてのデータをクリア」はセッション分離ファイルとローカル作業データをすべて削除します（設定・モデル・スキルは影響を受けません）。実行ログとクラッシュログは「ログ」ページのスイッチで制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'브라우저 캐시 지우기'는 웹 캐시(WebKit 캐시, URLCache, 공유 브라우저 데이터)를 정리합니다. '세션 캐시 지우기'는 각 세션 내 재생성 가능한 캐시(세션 브라우저 데이터, 서브에이전트 실행 기록)를 정리하며 대화 내용에는 영향이 없습니다. '오래된 첨부 지우기'는 정리 주기를 초과한 첨부를 삭제합니다. '모든 데이터 지우기'는 모든 세션 분리 파일과 로컬 작업 데이터를 삭제합니다(설정, 모델, 스킬은 영향 없음). 실행 로그와 크래시 로그는 '로그' 페이지의 스위치로 제어합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「清理浏览器缓存」清理网页缓存（WebKit 缓存、URLCache、共享浏览器数据）；「清理会话缓存」清理各会话内可重建的缓存数据（会话浏览器数据、子代理运行期记录），不影响会话内容；「清理旧附件」删除超过清理周期的附件；「清除所有数据」删除全部会话隔离文件与本地工作数据（设置、模型与技能不受影响）。运行日志与崩溃日志由「日志」页的开关控制。"
          }
        }
      }
    },
