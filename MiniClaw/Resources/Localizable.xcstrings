    "close_subagent_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close an existing subagent that is no longer needed (e.g. a research task that is fully complete). Closing removes its conversation and avatar, frees context, and it cannot be reused (dispatch a new one if needed again)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭一个已存在但后续不再需要的子代理（如某调研任务已彻底完成）。关闭后其会话与上方头像一并移除、上下文释放，不可再复用（如再需要，重新派发新建即可）。"
          }
        }
      }
    },
    "coarse_location_keeps_the_app_running_in_the_background_it_is_enabled_only_when_background_run_is_on_and_permission_is_granted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coarse location keeps the app running in the background; it is enabled only when “Background Run” is on and permission is granted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "概略位置はバックグラウンドでアプリを実行し続けるために使用され、「バックグラウンド実行」が有効でかつ許可されている場合のみ有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대략적 위치는 백그라운드에서 앱이 실행되도록 유지하는 데 사용되며, '백그라운드 실행'이 켜져 있고 권한이 부여된 경우에만 활성화됩니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊定位用于在后台保持 App 运行，仅当「后台运行」开启且已授权时启用。"
          }
        }
      }
    },
