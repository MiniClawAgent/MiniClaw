    "tap_a_model_to_open_its_detail_page_and_adjust_parameters_set_the_default_inference_model_as_the_main_model_in_model_groups" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a model to open its detail page and adjust parameters. Set the default inference model as the main model in Model Groups."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルをタップすると詳細ページが開き、パラメータを調整できます。既定の推論モデルは「モデルグループ」のメインモデルで設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델을 탭하면 상세 페이지가 열려 매개변수를 조정할 수 있습니다. 기본 추론 모델은 '모델 그룹'에서 메인 모델로 설정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击模型进入详情页调整参数；默认推理模型请在「模型分组」中设置主模型。"
          }
        }
      }
    },
    "tap_add_mount_folder_below_then_choose_a_folder_from_the_files_app" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Add Mount Folder” below, then choose a folder from the Files app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の「マウントフォルダを追加」をタップし、ファイル App からフォルダを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래의 「마운트 폴더 추가」를 탭한 뒤 파일 App에서 폴더를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击下方「添加挂载文件夹」，从文件 App 中选择一个文件夹。"
          }
        }
      }
    },
    "tap_sort_to_enter_edit_mode_and_drag_to_adjust_priority_swipe_left_on_a_row_to_remove_a_model_the_list_order_is_the_failover_limited_attempt_order_earlier_entries_are_tried_first_and_only_on_failure_does_it_move_down_the_list" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap \"Sort\" to enter edit mode and drag to adjust priority; swipe left on a row to remove a model. The list order is the failover (limited) attempt order: earlier entries are tried first, and only on failure does it move down the list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「並び替え」をタップして編集モードに入り、ドラッグで優先順位を調整できます。行を左にスワイプするとモデルを削除できます。リストの順序はフェイルオーバー（limited）の試行順です。先頭ほど優先して使用され、失敗した場合のみ順に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"정렬\"을 탭하여 편집 모드로 들어가 드래그로 우선순위를 조정하세요. 행을 왼쪽으로 스와이프하면 모델을 제거할 수 있습니다. 목록 순서는 장애 조치(limited) 시도 순서입니다. 앞에 있을수록 먼저 사용되고, 실패할 때만 순서대로 전환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点「排序」进入编辑模式可拖动调整优先级；行左滑可移除模型。列表顺序即故障转移（limited）尝试顺序：排在前面的优先使用，失败才按顺序轮换。"
          }
        }
      }
    },
