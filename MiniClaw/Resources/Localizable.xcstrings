    "browser_navigate_timeout_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ No load-complete event within 30s (the site may still be loading, or it never fires one — common on news sites with continuous third-party requests or long-polling). The content below may be INCOMPLETE: if the data you need is missing, use another source or re-read with get_readable instead of assuming the page finished loading."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 30 秒以内に「読み込み完了」イベントを受信できませんでした（サイトがまだ読み込み中の可能性、またはこのイベントを発火しないサイト——継続的なサードパーティ通信やロングポーリングを行うニュースサイトでよくあります）。以下の内容は**不完全な可能性があります**：必要なデータが欠けている場合は、別の情報源を使うか get_readable で再取得してください。ページが完全に読み込まれたと仮定しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 30초 내에 \"로드 완료\" 이벤트를 받지 못했습니다(사이트가 아직 로딩 중이거나, 이 이벤트를 발생시키지 않는 사이트 — 지속적인 서드파티 요청이나 롱폴링을 쓰는 뉴스 사이트에서 흔합니다). 아래 내용은 **불완전할 수 있습니다**: 필요한 데이터가 없다면 다른 출처를 쓰거나 get_readable로 다시 가져오세요. 페이지가 완전히 로드되었다고 가정하지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 30 秒内未收到「加载完成」事件（该站点可能仍在加载，也可能从不发出该事件——持续第三方请求/长轮询的新闻类站点很常见）。下面的内容**可能不完整**：如果缺了你需要的数据，请换一个来源，或用 get_readable 再取一次，不要假定页面已完全加载。"
          }
        }
      }
    },
    "browser_need_params_url" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigate requires the params.url parameter. Call again with params: {\"url\": \"https://...\"}; max_length only applies to get_readable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigate には必須パラメータ params.url がありません。params: {\"url\": \"https://...\"} で再呼び出ししてください。max_length は get_readable のみに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigate에 필수 매개변수 params.url이 없습니다. params: {\"url\": \"https://...\"}로 다시 호출하세요. max_length는 get_readable에만 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigate 缺少必填参数 params.url。请使用 params: {\"url\": \"https://...\"} 重新调用；max_length 仅适用于 get_readable。"
          }
        }
      }
    },
