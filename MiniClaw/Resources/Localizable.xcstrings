    "compress_prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a conversation-compression assistant. Compress the provided conversation into a concise summary, preserving key decisions, user intent, completed tasks, important conclusions, and open items. Do not use any tools; output only the summary text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは会話圧縮アシスタントです。提供された会話を簡潔な要約に圧縮し、重要な決定、ユーザーの意図、完了したタスク、重要な結論、未決事項を保持してください。ツールは使用せず、要約テキストのみを出力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 대화 압축 어시스턴트입니다. 제공된 대화를 간결한 요약으로 압축하되, 핵심 결정, 사용자 의도, 완료된 작업, 중요 결론, 미결 사항을 유지하세요. 도구를 사용하지 말고 요약 텍스트만 출력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是一个对话压缩助手。请将用户提供的对话记录压缩为简洁的中文摘要，保留关键决策、用户意图、已完成的任务、重要结论和未决事项。不要使用任何工具，只输出摘要文本。"
          }
        }
      }
    },
    "compress_prompt_zh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compress the conversation above into a concise summary, keeping only key decisions, user intent, completed tasks, important conclusions, and open items. Output only the summary text; do not call any tools or add extra content."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上の会話を簡潔な要約に圧縮し、重要な決定、ユーザーの意図、完了したタスク、重要な結論、未決事項のみを残してください。要約テキストのみを出力し、ツールは使用せず、余計な内容は追加しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 대화를 간결한 요약으로 압축하여 핵심 결정, 사용자 의도, 완료된 작업, 중요 결론, 미결 사항만 남기세요. 요약 텍스트만 출력하고 도구를 사용하지 말며 추가 내용을 넣지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请把上面的对话压缩为简洁摘要，仅保留关键决策、用户意图、已完成的任务、重要结论与未决事项。直接输出摘要文本，不要调用任何工具，不要添加额外内容。"
          }
        }
      }
    },
