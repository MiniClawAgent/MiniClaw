    "only_takes_effect_when_a_search_term_is_typed_in_the_address_bar_the_default_homepage_is_unaffected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to search jumps for terms typed in the address bar and to the agent's fallback search when a tool call has no concrete URL; the default homepage is unaffected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスバーに入力した検索語のジャンプ、およびツール呼び出しに具体的な URL がない場合のエージェントのフォールバック検索に適用されます。デフォルトのホームページには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소 표시줄에 입력한 검색어 이동과, 도구 호출에 구체적인 URL 이 없을 때의 에이전트 대체 검색에 적용됩니다. 기본 홈페이지에는 영향이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于地址栏搜索词的跳转，以及智能体工具调用未提供具体网址时的兜底搜索；不影响默认首页。"
          }
        }
      }
    },
