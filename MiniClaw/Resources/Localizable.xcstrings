    "read_subagent_result_suffix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarize the confirmed information (including verified channels and conclusions), then give the conclusion or next-step suggestion;"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認済みの情報（検証済みの経路と結論を含む）を要約し、結論または次のステップの提案を示してください。"
