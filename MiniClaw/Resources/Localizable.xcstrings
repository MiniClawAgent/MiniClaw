    "vision_unsupported_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Image] The user attached %d image(s) (%@), but the current model has no native vision support. Use the apple-vision tool to understand them. Image paths: \"%@\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[画像] ユーザーが %d 枚の画像（%@）を添付しましたが、現在のモデルはネイティブな視覚入力に対応していません。apple-vision ツールで画像を分析してください。画像パス：\"%@\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[이미지] 사용자가 이미지 %d장(%@)을 첨부했지만 현재 모델은 네이티브 비전 입력을 지원하지 않습니다. apple-vision 도구로 분석하세요. 이미지 경로: \"%@\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[图片] 用户附件了 %d 张图片 (%@)，但当前模型不支持原生视觉输入。请使用 apple-vision 工具分析这些图片来理解用户意图。图片路径：\"%@\""
          }
        }
      }
    },
