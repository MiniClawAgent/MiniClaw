    "follow_main_model_no_override_use_the_model_s_default_thinking_thinking_off_subagents_answer_quickly_and_directly_saving_tokens_at_some_quality_cost" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Follow main model\" = no override, use the model's default thinking; \"Thinking off\" = subagents answer quickly and directly, saving tokens at some quality cost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「メインモデルに従う」= 強制せずモデル既定の思考を使用；「思考オフ」= サブエージェントが迅速に直接回答し、トークン節約（品質は低下）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'주 모델 따르기' = 강제하지 않고 모델 기본 사고를 사용합니다. '사고 끄기' = 서브에이전트가 빠르게 직접 답변하여 토큰을 절약하지만 품질은 낮아집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟随主模型」= 不强制，按模型默认思考；「关闭思考」= 子代理快速直接作答，省 token 但质量下降。"
          }
        }
      }
    },
