    "tool_indicator_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required. Describe this call's concrete action in 6-16 words for the tool indicator. Examples: read config file, search yesterday's memory, create calendar event, check weather. Do not put the tool name or raw action here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須。この呼び出しの具体的な行動を6〜16字で記述し、ツールインジケーターに表示します。例：設定ファイルを読む、昨日の記憶を検索。ツール名や action をそのまま書かないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필수. 이 호출의 구체적 행동을 6-16자로 설명하여 도구 표시기에 표시합니다. 예: 설정 파일 읽기, 어제 기억 검색. 도구 이름이나 원본 action을 쓰지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必填。用6-16字描述本次调用的具体行为，供工具指示器展示。例如：读取配置文件、搜索昨日记忆、创建日历事件、查询当前天气。不要填写工具名或原始 action。"
          }
        }
      }
    },
