        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI wants to read your health data (steps, heart rate, sleep and similar) to answer your question. This approval applies to the current session only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
