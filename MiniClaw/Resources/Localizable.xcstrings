    "sys_tool_calls_mismatch" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ System note: you intended to call a tool this turn (finish_reason=tool_calls) but did not issue a valid tool call. Re-issue the tool call in the correct format, or explain why it cannot be completed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ システム通知：あなたはこのターンでツールを呼び出すつもりでした（finish_reason=tool_calls）が、有効なツール呼び出しを発行しませんでした。正しい形式で再呼び出しするか、完了できない理由を説明してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 시스템 안내: 이번 턴에 도구를 호출하려 했으나(finish_reason=tool_calls) 유효한 도구 호출을 발행하지 않았습니다. 올바른 형식으로 다시 호출하거나 완료할 수 없는 이유를 설명하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 系统提示：你本轮意图调用工具（finish_reason=tool_calls）但未发出有效的工具调用，请重新以正确格式调用工具，或说明无法完成的原因。"
          }
        }
      }
    },
