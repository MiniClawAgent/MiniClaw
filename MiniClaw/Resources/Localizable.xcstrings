    "not_supported" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not Supported"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非対応"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원 안 됨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持"
          }
        }
      }
    },
    "not_supported_means_the_model_profile_marks_this_model_as_lacking_that_input_capability_matching_attachments_are_skipped_when_sending_text_is_the_universal_baseline_and_is_on_by_default" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Not supported\" means the model profile marks this model as lacking that input capability; matching attachments are skipped when sending. Text is the universal baseline and is on by default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「非対応」はモデルプロファイルがその入力能力を持たないことを示します。送信時に対応する添付ファイルは自動的にスキップされます。テキストは共通ベースラインで、デフォルトで有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'미지원'은 모델 프로필이 해당 입력 능력이 없음을 표시하며, 전송 시 해당 유형의 첨부 파일은 자동으로 건너뜁니다. 텍스트는 공통 기준이며 기본적으로 켜져 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「不支持」表示模型档案标注该模型无此输入能力；发送时会自动跳过对应类型的附件。文本为通用基线，默认开启。"
          }
        }
      }
    },
    "not_supported_means_the_model_profile_marks_this_model_as_lacking_this_input_capability_such_attachments_are_automatically_skipped_when_sending" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Not supported\" means the model profile marks this model as lacking this input capability; such attachments are automatically skipped when sending."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「対応なし」は、モデルプロフィールでこのモデルにこの入力能力がないとマークされていることを意味します。送信時には該当する種類の添付ファイルが自動的にスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"지원 안 함\"은 모델 프로필에서 이 모델이 해당 입력 기능이 없다고 표시됨을 의미합니다. 전송 시 해당 유형의 첨부는 자동으로 건너뜁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「不支持」表示模型档案标注该模型无此输入能力；发送时会自动跳过对应类型的附件。"
          }
        }
      }
    },
