    "control_section_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System data and device capabilities the AI can access. Each takes effect only after you grant it in System Settings, is used only for conversations you start, and is never uploaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI がアクセスできるシステムデータとデバイス機能です。いずれもシステム設定で許可した場合のみ有効となり、あなたが開始した会話にのみ使用され、アップロードされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 접근할 수 있는 시스템 데이터와 기기 기능입니다. 모두 시스템 설정에서 허용한 경우에만 적용되며, 사용자가 시작한 대화에만 사용되고 업로드되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 可访问的系统数据与设备能力。均需你在系统设置中授权后生效，且只用于你发起的对话，不会上传。"
          }
        }
      }
    },
