    "param_update_field_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Field name for update; one of: title/model/agentName/status/icon/iconColor. icon is an SF Symbol name (e.g. 'bookmark.fill', 'brain.head.profile'); pass an empty string to clear the custom icon and revert to default. iconColor is a hex color (e.g. '#FF6B6B') matched to the conversation theme, with a 0.12-transparency background auto-applied; pass an empty string to clear. Note: do not use pure black (#000000), pure white (#FFFFFF), or near-black/white colors — they are invisible on dark/light backgrounds. Choose a clear color, otherwise it will be ignored and fall back to the default blue"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "update 的字段名，可选: title/model/agentName/status/icon/iconColor。icon 为 SF Symbol 名称（如 'bookmark.fill'、'brain.head.profile'），传空字符串可清除自定义图标回退默认；iconColor 为十六进制颜色（如 '#FF6B6B'），与会话主题匹配，背景自动取该色 0.12 透明，传空字符串清除。注意：禁止使用纯黑(#000000)、纯白(#FFFFFF)或接近的黑/白色，它们在深色/浅色背景下会不可见，请选用明确的彩色，否则将被忽略回退默认蓝"
          }
        }
      }
    },
