    "choose_a_model_group_or_a_single_model_per_purpose_none_means_unspecified_the_secondary_model_also_handles_all_background_tasks_titles_memory_subagents_embedding_etc_subagents_automatically_use_the_secondary_model_no_separate_setup_needed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a model group or a single model per purpose; \"None\" means unspecified. The secondary model also handles all background tasks — titles, memory, subagents, Embedding, etc. (subagents automatically use the secondary model; no separate setup needed)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用途ごとにモデルグループまたは単一モデルを選択。「なし」は未指定。サブモデルはタイトル・記憶・サブエージェント・Embedding などすべてのバックグラウンドタスクも担当します（サブエージェントは自動的にサブモデルを使用、個別設定不要）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용도별로 모델 그룹 또는 단일 모델을 선택합니다. '없음'은 미지정입니다. 보조 모델은 제목, 기억, 서브에이전트, Embedding 등 모든 백그라운드 작업을 담당합니다(서브에이전트는 자동으로 보조 모델을 사용하므로 별도 설정 불필요)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为不同用途选择模型组或单个模型；选择“无”表示不指定。副模型同时承担标题、记忆、子代理、Embedding 等全部后台任务（子代理自动走副模型，无需单独设置）。"
          }
        }
      }
    },
    "choose_a_model_group_or_an_individual_model_for_each_purpose_none_means_unspecified_the_secondary_model_also_handles_background_tasks_such_as_titles_and_memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
