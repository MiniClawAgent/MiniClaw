    "crash_report_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structured crash reports auto-generated when the app crashes or exits abnormally (crash-年月日-时分秒.log). Swipe left to delete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがクラッシュや異常終了した際に自動生成される構造化クラッシュレポート（crash-年月日-时分秒.log）。左にスワイプで削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 강제 종료되거나 비정상 종료될 때 자동 생성되는 구조화된 크래시 리포트(crash-年月日-时分秒.log). 왼쪽으로 스와이프하여 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用闪退或异常退出时自动生成的结构化崩溃报告（crash-年月日-时分秒.log）。左滑可删除。"
          }
        }
      }
    },
    "crash_report_full_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structured crash reports auto-generated on app crash/abnormal exit (crash-YYYYMMDD-HHMMSS.log). Swipe left to delete. crash- prefix = in-app signal/launch-detection reports; mxcrash- prefix = system-level (MetricKit) reports, covering crashes the app cannot catch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structured crash reports auto-generated on app crash/abnormal exit (crash-YYYYMMDD-HHMMSS.log). Swipe left to delete. crash- prefix = in-app signal/launch-detection reports; mxcrash- prefix = system-level (MetricKit) reports, covering crashes the app cannot catch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structured crash reports auto-generated on app crash/abnormal exit (crash-YYYYMMDD-HHMMSS.log). Swipe left to delete. crash- prefix = in-app signal/launch-detection reports; mxcrash- prefix = system-level (MetricKit) reports, covering crashes the app cannot catch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用闪退或异常退出时自动生成的结构化崩溃报告（crash-年月日-时分秒.log）。左滑可删除。crash- 前缀为 App 内信号/启动检测报告；mxcrash- 前缀为系统级（MetricKit）报告，兜底 App 内抓不到的崩溃。"
          }
        }
      }
    },
