    "models_that_only_support_text_output_are_marked_not_supported_here_so_you_can_tell_the_model_type_at_a_glance_text_is_the_universal_baseline_and_is_on_by_default" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models that only support text output are marked \"Not supported\" here, so you can tell the model type at a glance. Text is the universal baseline and is on by default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト出力のみ対応のモデルはここで「非対応」と表示され、モデルタイプが一目で分かります。テキストは共通ベースラインで、デフォルトで有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 출력만 지원하는 모델은 여기서 '미지원'으로 표시되어 모델 유형을 한눈에 알 수 있습니다. 텍스트는 공통 기준이며 기본적으로 켜져 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅支持文本输出的模型此处均为「不支持」，一眼即可识别模型类型。文本为通用基线，默认开启。"
          }
        }
      }
    },
    "models_that_only_support_text_output_are_marked_unsupported_here_so_you_can_tell_the_model_type_at_a_glance" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models that only support text output are marked “Unsupported” here, so you can tell the model type at a glance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト出力のみ対応のモデルはここではすべて「非対応」と表示され、モデルの種類が一目でわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 출력만 지원하는 모델은 여기서 모두 ‘미지원’으로 표시되어 모델 유형을 한눈에 알 수 있습니다。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅支持文本输出的模型此处均为「不支持」，一眼即可识别模型类型。"
          }
        }
      }
    },
