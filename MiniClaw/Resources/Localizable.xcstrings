      }
    },
    "allow_health_read_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When enabled, the AI can read data such as steps, heart rate and sleep to answer your questions. When off, every read asks for your approval first, and the approval lasts only for that session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定ではオフです。オンにすると、AI は歩数・心拍数・睡眠などのデータを読み取り、ご質問に回答できます。オフの場合は読み取りのたびに承認を求められ、その承認はその会話内でのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 켜면 AI가 걸음 수, 심박수, 수면 등의 데이터를 읽어 질문에 답할 수 있습니다. 꺼져 있으면 읽을 때마다 승인을 요청하며, 승인은 해당 대화에서만 유효합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。开启后，AI 可读取步数、心率、睡眠等数据来回答你的提问；关闭时，AI 每次读取都会先弹出授权请求，只有你同意才能读（仅该次会话有效）。"
          }
        }
      }
    },
    "allow_health_write" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow AI to write health data (HealthKit)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI によるヘルスデータ書き込みを許可（HealthKit）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 건강 데이터 기록 허용(HealthKit)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 AI 写入健康数据（HealthKit）"
          }
        }
      }
    },
    "allow_health_write_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When enabled, the AI can add steps, weight, water and similar records to the Health app. These records mix with Apple Watch data and affect rings and trends. The AI can only delete samples it wrote itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定ではオフ。オンにすると AI が「ヘルスケア」に歩数・体重・水分などの記録を追加できます。これらの記録は Apple Watch のデータと混ざり、アクティビティリングやトレンドに影響します。AI が削除できるのは自分で書き込んだサンプルのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 켜면 AI 가 건강 앱에 걸음 수, 체중, 수분 섭취량 등을 기록할 수 있습니다. 이 기록은 Apple Watch 데이터와 섞여 활동 링과 추세에 영향을 줍니다. AI 는 자신이 기록한 샘플만 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。开启后，AI 可以向「健康」App 添加步数、体重、饮水等记录。这些记录会与 Apple Watch 数据混在一起，并影响活动圆环与趋势图表。AI 只能删除它自己写入的样本。"
          }
        }
      }
    },
