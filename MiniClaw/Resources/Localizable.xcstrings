    "you_can_fill_in_an_existing_access_token_directly_leave_the_api_url_empty_to_use_the_official_default" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can fill in an existing access token directly. Leave the API URL empty to use the official default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のアクセストークンをそのまま入力できます。API アドレスを空にすると公式のデフォルトを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 액세스 토큰을 바로 입력할 수 있습니다. API 주소를 비우면 공식 기본 주소를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有访问令牌时可直接填入。API 地址留空则使用官方默认地址。"
          }
        }
      }
    },
    "you_must_save_the_provider_key_before_testing" : {
      "extractionState" : "manual",
      "localizations" : {
