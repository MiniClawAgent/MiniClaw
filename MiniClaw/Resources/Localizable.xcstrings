          }
        }
      }
    },
    "read_subagent_result_tool_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page through a subagent's complete final answer by subagent_id (dispatch_subagent returns only a bounded preview). Use it when you need the full content of a subagent result (long text, full report, detailed list); use offset paging to read the entire answer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "subagent_id を指定してサブエージェントの完全な最終回答をページ送りで読み取ります（dispatch_subagent は有界プレビューのみ返却）。サブエージェント結果の全文（長文、レポート全文、詳細リスト）が必要なときに使用し、offset ページングで全体を読み切れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "subagent_id로 서브에이전트의 완전한 최종 답변을 페이지 단위로 읽습니다(dispatch_subagent는 유한한 미리보기만 반환). 서브에이전트 결과의 전체 내용(긴 글, 전체 보고서, 상세 목록)이 필요할 때 사용하며 offset 페이징으로 전체를 읽을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 subagent_id 分页读取某个子代理的完整最终回答（dispatch_subagent 只返回有界预览）。当需要子代理结果的完整内容（长文、报告全文、详细清单）时使用；offset 翻页可读完整个回答。"
          }
        }
      }
    },
