    "compress_prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a conversation-compression assistant. Compress the provided conversation into a concise summary, preserving key decisions, user intent, completed tasks, important conclusions, and open items. Do not use any tools; output only the summary text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是一个对话压缩助手。请将用户提供的对话记录压缩为简洁的中文摘要，保留关键决策、用户意图、已完成的任务、重要结论和未决事项。不要使用任何工具，只输出摘要文本。"
          }
        }
      }
    },
    "compress_prompt_zh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compress the following conversation, keeping only key decisions, user intent, completed tasks, important conclusions, and open items. Output concise Chinese; do not add extra content:\\n\\n"
          }
        },
