<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>MiniClaw</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.neartop.miniclaw.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>miniclaw</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>MiniClaw 需要访问媒体库以播放和控制音乐。</string>
	<!-- 本地网络：声明本 app 会浏览的 Bonjour 服务类型。未声明时系统可能静默拦截
	     浏览动作（既不返回结果、也不弹本地网络授权框），表现为「发现不到设备且
	     设置 → 隐私与安全性 → 本地网络里根本没有本 app」，权限无从开启。
	     - _ssh._tcp：remote-host 发现局域网内可 SSH 的设备（Mac 远程登录/avahi 广播）
	     - _miniclaw._tcp：权限探测用虚构类型（不存在也不影响，浏览动作本身触发授权弹窗） -->
	<key>NSBonjourServices</key>
	<array>
		<string>_ssh._tcp</string>
		<string>_miniclaw._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MiniClaw 需要完整访问日历以读取、创建和修改您的日程事件。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>MiniClaw 需要访问日历以管理和创建日程事件。</string>
	<key>NSCameraUsageDescription</key>
	<string>MiniClaw 需要使用相机拍照或扫描二维码。</string>
	<key>NSContactsUsageDescription</key>
	<string>MiniClaw 需要访问通讯录以查找联系人信息，以及创建和修改您让 AI 代为录入的联系人。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MiniClaw 需要读取您的健康数据——活动与步数、心率、体重等身体测量、睡眠、血压/血糖/血氧、饮水与膳食、运动记录——用于回答您的健康相关提问。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>MiniClaw 需要写入您授权的健康数据——步数、活动能量、体重、身高、体脂率、正念时长、饮水量与膳食能量——用于记录您让 AI 代为录入的条目。</string>
	<key>NSHomeKitUsageDescription</key>
	<string>MiniClaw 需要访问 HomeKit 以控制您的智能家居设备。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MiniClaw 需要访问本地网络以发现和连接本地设备与服务。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MiniClaw 需要使用您的位置信息来提供基于位置的服务，如天气查询和定位相关功能。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MiniClaw 需要使用麦克风进行语音输入和语音识别。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MiniClaw 需要写入权限以把图片保存到您的照片库。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MiniClaw 需要访问照片库以读取和保存图片。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>MiniClaw 需要完整访问提醒事项以读取、创建和修改您的提醒。</string>
	<key>NSRemindersUsageDescription</key>
	<string>MiniClaw 需要访问提醒事项以创建和管理提醒。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MiniClaw 需要使用语音识别将您的语音转换为文字。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSUserNotificationsUsageDescription</key>
	<string>MiniClaw 需要发送通知来提醒您重要信息。</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.neartop.miniclaw.processing.consolidate</string>
		<string>com.neartop.miniclaw.refresh.maintenance</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
