    "quick_task_config_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a common command; tapping the widget sends it straight to MiniClaw to run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置一句常用指令，点按小组件即可直接派发给 MiniClaw 执行。"
          }
        },
        "ja": {
          "stringUnit": {
            "type": "string",
            "value": "よく使うコマンドを設定すると、ウィジェットをタップするだけで MiniClaw に直接実行を依頼できます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "type": "string",
            "value": "자주 쓰는 명령을 설정하면 위젯을 탭하여 MiniClaw에 바로 실행을 맡길 수 있습니다.",
            "state": "translated"
          }
        }
      }
    },
    "quick_task_default_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize my todos today and suggest priorities"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总结我今天的待办并给出优先级建议"
          }
        },
        "ja": {
          "stringUnit": {
            "type": "string",
            "value": "今日の ToDo をまとめて優先順位の提案をして",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "type": "string",
            "value": "오늘의 할 일을 요약하고 우선순위를 제안해 줘",
            "state": "translated"
          }
        }
      }
    },
    "quick_task_dispatch": {
