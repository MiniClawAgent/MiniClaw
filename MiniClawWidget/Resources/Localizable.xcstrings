    "widget_quick_task_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin a common command to the home screen; tap to dispatch it to the Agent to run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一句常用指令固定到桌面，点按直接派给智能体执行。"
          }
        },
        "ja": {
          "stringUnit": {
            "type": "string",
            "value": "よく使うコマンドをホーム画面に固定し、タップでエージェントに実行を依頼します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "type": "string",
            "value": "자주 쓰는 명령을 홈 화면에 고정하고, 탭하여 에이전트에게 실행을 맡깁니다.",
            "state": "translated"
          }
        }
