    "widget_quick_actions_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump straight into a new chat, terminal, or settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一步进入新对话、终端或设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "type": "string",
            "value": "ワンタップで新しい会話・ターミナル・設定へ移動します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "type": "string",
            "value": "한 번에 새 대화, 터미널 또는 설정으로 이동합니다.",
            "state": "translated"
          }
        }
